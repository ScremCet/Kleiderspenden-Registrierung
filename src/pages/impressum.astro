---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <h2 class="mb-4">Impressum</h2>

      <section class="mb-4">
        <h3 class="h5">Angaben gemäß § 5 TMG</h3>
        <p class="mb-1"><strong>Kleiderspenden-Verein</strong></p>
        <p class="mb-1">Musterstraße 1</p>
        <p class="mb-1">12345 Musterstadt</p>
      </section>

      <section class="mb-4">
        <h3 class="h5">Vertreten durch</h3>
        <p>Vorstand des Kleiderspenden-Vereins</p>
      </section>

      <section class="mb-4">
        <h3 class="h5">Kontakt</h3>
        <p class="mb-1">E-Mail: kontakt@kleiderspenden-verein.de</p>
        <p class="mb-1">Telefon: +49 123 4567890</p>
      </section>

      <section>
        <h3 class="h5">Haftungshinweis</h3>
        <p class="mb-0">Diese Seite ist Teil eines Projektbeispiels. Die Angaben sind als Platzhalter für die Aufgabenstellung zu verstehen.</p>
      </section>
    </div>
  </div>
</Layout>

